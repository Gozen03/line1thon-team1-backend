# EC2에서 이 파일을 .env.main으로 복사해 값을 채운다 (.env.main은 깃에 올리지 않음)
# 값에 따옴표·공백을 넣지 않는다
DB_URL=jdbc:mysql://<RDS 엔드포인트>:3306/jisik_namu?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=jisik
DB_PASSWORD=

# JWT 서명 키 (Base64, 64바이트)
JWT_SECRET=

# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET=

# AI 서버 (같은 Compose 안)
AI_SERVER_URL=http://ai:8000
# AI 서버 .env.ai와 같은 값
AI_INTERNAL_KEY=
# AI 서버를 쓰면 false (2차 배포부터). true면 AI 서버 없이 가짜 응답
AI_MOCK=true
AI_MOCK_DELAY_MS=3000

# 복습 대기 일수 (운영 3, 1). 시연은 0으로 바꾸고 docker compose up -d main
REVIEW_DELAY_DAYS=3
REVIEW_RETRY_DELAY_DAYS=1

# 프론트 주소 (여러 개면 쉼표로)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://line1thon-grooit.vercel.app
