# EC2에서 이 파일을 .env.ai로 복사해 값을 채운다 (.env.ai는 깃에 올리지 않음). 항목은 ai-server/README.md 참고
# 메인 서버 .env.main의 AI_INTERNAL_KEY와 같은 값
AI_INTERNAL_KEY=
# OpenAI 플랫폼에서 받은 키
OPENAI_API_KEY=
# 아무 긴 임의 문자열
DJANGO_SECRET_KEY=
# 선택 (기본값: openai, gpt-6-luna, none)
# AI_PROVIDER=openai
# AI_MODEL=gpt-6-luna
# AI_REASONING_EFFORT=none
