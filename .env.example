# 이 파일을 복사해 .env를 만들고 값을 채운다 (.env는 깃에 올리지 않음)
# 로컬 Docker MySQL (docker-compose.local.yml)
DB_ROOT_PASSWORD=
DB_URL=jdbc:mysql://localhost:3307/jisik_namu?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USERNAME=jisik
DB_PASSWORD=

# JWT 서명 키 (Base64, 64바이트 이상 권장)
JWT_SECRET=

# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
# 비어 있으면 사진을 저장하지 않는 Mock을 쓴다
S3_BUCKET=
# S3 호환 서버로 시험할 때만 쓴다
S3_ENDPOINT=

# AI 서버 (로컬은 Mock, EC2는 http://ai:8000)
AI_SERVER_URL=http://localhost:8000
# AI 서버 .env.ai와 같은 값
AI_INTERNAL_KEY=
# AI 서버가 없을 때 가짜 응답을 쓴다
AI_MOCK=true
# 가짜 응답 대기 시간(ms). 로딩 화면 확인용
AI_MOCK_DELAY_MS=0

# 복습 대기 일수 (기본 3, 1). 시연은 0으로 바로 복습한다
REVIEW_DELAY_DAYS=3
REVIEW_RETRY_DELAY_DAYS=1

# 프론트 주소 (여러 개면 쉼표로)
CORS_ALLOWED_ORIGINS=http://localhost:5173
